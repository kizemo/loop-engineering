name: PR Review (Loop Engineering Playbook A)

on:
  pull_request:
    types: [opened, synchronize, reopened]

permissions:
  contents: read
  pull-requests: write

jobs:
  review:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    env:
      ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}

    steps:
      - name: Checkout PR diff
        uses: actions/checkout@v4
        with:
          fetch-depth: 0
          ref: ${{ github.event.pull_request.head.ref }}

      - name: Generate diff
        id: diff
        run: |
          git fetch origin ${{ github.event.pull_request.base.ref }}
          DIFF=$(git diff origin/${{ github.event.pull_request.base.ref }}...HEAD)
          echo "diff<<EOF" >> $GITHUB_OUTPUT
          echo "$DIFF" >> $GITHUB_OUTPUT
          echo "EOF" >> $GITHUB_OUTPUT

      - name: Run AI reviewer (only review, no fix)
        id: review
        env:
          PR_DIFF: ${{ steps.diff.outputs.diff }}
        run: |
          # NOTE: --max-budget-usd 0.50 限单 PR 不超过 0.5 美元
          # NOTE: claude -p 是 headless 模式,exit 0/1 可塞 CI
          # NOTE: 提示词强制 "review only, do not modify code"
          PROMPT="Review the following PR diff for security issues, common bugs, and style violations. Output markdown comments only. DO NOT suggest code modifications, only identify issues with line references.

          PR Title: ${{ github.event.pull_request.title }}
          PR Description: ${{ github.event.pull_request.body }}

          Diff:
          \`\`\`
          $PR_DIFF
          \`\`\`"
          REVIEW=$(echo "$PROMPT" | claude -p --max-budget-usd 0.50)
          echo "review<<EOF" >> $GITHUB_OUTPUT
          echo "$REVIEW" >> $GITHUB_OUTPUT
          echo "EOF" >> $GITHUB_OUTPUT

      - name: Post review comment
        uses: marocchino/sticky-pull-request-comment@v2
        with:
          header: loop-engineering-review
          message: |
            ## 🤖 Loop Engineering Review

            ${{ steps.review.outputs.review }}

            ---
            <sub>Reviewed by Claude · max budget $0.50 · [Playbook A](https://github.com/<YOUR_ORG>/loop-engineering/blob/main/playbooks/A-pr-review/README.md)</sub>

# =============================================================================
# To enable this workflow:
#   1. Replace <YOUR_ORG> with your GitHub org/user
#   2. Add ANTHROPIC_API_KEY to GitHub Secrets
#   3. Install Claude CLI on the runner: https://code.claude.com/docs/en/setup
#   4. Commit to .github/workflows/pr-review.yml
#
# This is the "review only, do not modify" variant. To enable auto-fix:
#   - Add a second job that runs claude -p "fix the issues"
#   - Set --max-budget-usd 1.00 for the fix job
#   - Add PreToolUse hooks to block dangerous commands
# =============================================================================